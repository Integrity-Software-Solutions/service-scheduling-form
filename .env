# Client-side API config (inlined at build time for static export).
# Leave mocks on until PHP-FPM endpoints are ready.

NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_TICKET=https://api.integrityprodserver.com/intserver-api/lp/customReport.php
NEXT_PUBLIC_API_BLOCKS=https://api.integrityprodserver.com/serviceAppointments/getServiceAvailability.php
NEXT_PUBLIC_API_SCHEDULE=https://api.integrityprodserver.com/serviceAppointments/setServiceAppointment.php
#NEXT_PUBLIC_API_CUSTOMER=https://api.integrityprodserver.com/serviceAppointments/getWarrantyProducts.php
NEXT_PUBLIC_API_CUSTOMER=https://api.integrityprodserver.com/serviceAppointments/getWarrantyProductsAuth.php

