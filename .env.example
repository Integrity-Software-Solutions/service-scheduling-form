# Client-side API config (inlined at build time for static export).
# Leave mocks on until PHP-FPM endpoints are ready.

NEXT_PUBLIC_USE_MOCKS=true

# Example paths once live on the PHP host (same origin preferred):
# NEXT_PUBLIC_USE_MOCKS=false
# NEXT_PUBLIC_API_TICKET=/scripts/service-scheduling/service-ticket.php
# NEXT_PUBLIC_API_CUSTOMER=/scripts/service-scheduling/getWarrantyProducts.php
#   Response: { customer, products[] } where products[].id is the option value
#   and products[].productid is the display label
# NEXT_PUBLIC_API_CREATE_TICKET=/scripts/service-scheduling/create-ticket.php
# NEXT_PUBLIC_API_BLOCKS=/scripts/service-scheduling/time-blocks.php
#   Query params: start, end, cst_id, token, username
# NEXT_PUBLIC_API_SCHEDULE=/scripts/service-scheduling/schedule.php
# NEXT_PUBLIC_API_NOTES=/scripts/service-scheduling/notes.php
#
# Form URL must include token (+ username) which are forwarded to every endpoint.
